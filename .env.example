# Copy this file to .env and fill in your values, then run ./generate-configs.sh
# or `make gen`. Never commit .env.

# Required: public hostname of the WEB proxy (as seen by clients).
PUBLIC_HOSTNAME=proxy.example.com

# Required: client-facing MTProxy secret (32 lowercase hex chars).
# Generate a new one with: openssl rand -hex 16
# The same value is written into profiles.json and backend-config.py, so it
# stays in sync automatically. Existing clients must keep using the old value.
MT_SECRET=000102030405060708090a0b0c0d0e0f

# Optional: TLS domain for the MTProto backend (fake-TLS). Defaults to PUBLIC_HOSTNAME.
#TLS_DOMAIN=proxy.example.com

# Optional: relay listeners (must stay on loopback; TLS is terminated by an
# external reverse proxy mapping 443 -> RELAY_LISTEN).
#RELAY_LISTEN=127.0.0.1:8090
#ADMIN_LISTEN=127.0.0.1:8091

# Optional: MTProto backend address used by profiles.json and the port used by
# backend-config.py (derived from the address, keep in sync automatically).
#MT_BACKEND=127.0.0.1:8443

# Optional: carrier mode for the profile: https | https-lanes | websocket | websocket-lanes
#MT_CARRIER_MODE=https

# Optional: MTProxy profile / user name.
#MT_PROFILE_NAME=default